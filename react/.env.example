# --- osu! (https://osu.ppy.sh/home/account/edit#oauth) -----------------------
# Mêmes noms de variables que la version HTML/JS.
CLIENT_ID=
CLIENT_SECRET=
# Alternative acceptée : OSU_CLIENT_ID / OSU_CLIENT_SECRET (utilisées seulement
# si CLIENT_ID / CLIENT_SECRET ne sont pas définies).
# URL de callback, identique à celle déjà enregistrée dans osu! :
#   <domaine>/api/auth/callback
OSU_REDIRECT_URI=http://localhost:5173/api/auth/callback

# --- Session -----------------------------------------------------------------
# Au moins 32 caractères. Générer avec : openssl rand -base64 32
# (BETTER_AUTH_SECRET est accepté à la place de SESSION_SECRET.)
SESSION_SECRET=
# URL publique de l'app, sans slash final. Si absente, l'origine de
# OSU_REDIRECT_URI (ou VERCEL_URL) est utilisée.
# BETTER_AUTH_URL=http://localhost:5173

# --- Optionnel ---------------------------------------------------------------
# Incrémenter pour invalider immédiatement toutes les sessions existantes.
# AUTH_SESSION_VERSION=1
# Active GET /api/auth/check (diagnostic OAuth) : 16 caractères min., à envoyer
# dans `Authorization: Bearer <valeur>`. Sans cette variable, l'endpoint répond 404.
# DIAGNOSTICS_TOKEN=

# --- Conseiller IA (Gemini) --------------------------------------------------
# Clé créée sur https://aistudio.google.com/apikey — côté serveur uniquement,
# jamais dans le code ni dans le navigateur.
GEMINI_API_KEY=
# Optionnel : modèle principal (repli automatique sur d'autres modèles Flash).
# GEMINI_MODEL=gemini-3.1-flash-lite
